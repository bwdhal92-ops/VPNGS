<Window x:Class="FlareVpn.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات متقدمة" Icon="{StaticResource VpnGsLogo}"
        Height="650" Width="980" MinHeight="600" MinWidth="760"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="#10131B" Foreground="#E8ECF2" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#181C27"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#282E3D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8F9AAF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B35"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#10131B"/>
            <Setter Property="Foreground" Value="#F1F4FA"/>
            <Setter Property="CaretBrush" Value="#FF6B35"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF6B35"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF6B35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Background" Value="#FF8255"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#242A38"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckFrame" Width="19" Height="19" CornerRadius="5"
                                    Background="#10131B" BorderBrush="#454D60" BorderThickness="1.3">
                                <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4" Stroke="White"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckFrame" Property="Background" Value="#FF6B35"/>
                                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#FF6B35"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#FF9A75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ServerHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#202635"/>
            <Setter Property="Foreground" Value="#BBC5D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ServerRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#DCE2EE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowFrame" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowFrame" Property="Background" Value="#222938"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowFrame" Property="Background" Value="#33241F"/>
                                <Setter TargetName="RowFrame" Property="BorderBrush" Value="#B94F2B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

        <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="125"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <Button x:Name="SettingsPageButton" Content="الإعدادات" Click="SettingsPage_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
            <Button x:Name="ServersPageButton" Content="السيرفرات وسجل التشغيل" Click="ServersPage_Click" Style="{StaticResource SoftButton}"/>
        </StackPanel>

        <!-- Header -->
        <Grid x:Name="SettingsHeader" Grid.Row="1" Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="الإعدادات المتقدمة" FontSize="23" FontWeight="Bold" Foreground="#F4F6FB"/>
                <TextBlock Text="إدارة السيرفرات، منافذ البروكسي، وخيارات تشغيل VPNGS" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Proxy ports -->
        <Border x:Name="ProxyPortsSection" Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="منافذ البروكسي المحلي" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="تُطبّق عند الاتصال القادم" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="SOCKS" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SocksPortBox" Width="88" Height="36" Style="{StaticResource DarkTextBox}"
                                 FlowDirection="LeftToRight" MaxLength="5" ToolTip="منفذ SOCKS المحلي"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="HTTP" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="HttpPortBox" Width="88" Height="36" Style="{StaticResource DarkTextBox}"
                                 FlowDirection="LeftToRight" MaxLength="5" ToolTip="منفذ HTTP المحلي"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="حفظ المنافذ" Click="SaveProxyPorts_Click"
                        Style="{StaticResource SoftButton}" Margin="18,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Preferences -->
        <Border x:Name="PreferencesSection" Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#131722" CornerRadius="8" Padding="14,13" Margin="0,0,8,0">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindowsToggle" Content="بدء مع ويندوز" Style="{StaticResource ModernCheckBox}"
                                  IsChecked="{Binding Settings.StartWithWindows}" Checked="OptionalSetting_Changed" Unchecked="OptionalSetting_Changed"/>
                        <TextBlock Text="تشغيل VPNGS تلقائيًا عند تسجيل الدخول" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="29,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#131722" CornerRadius="8" Padding="14,13" Margin="4,0,0,0">
                    <StackPanel>
                        <CheckBox x:Name="MinimizeToTrayToggle" Content="التصغير إلى شريط النظام" Style="{StaticResource ModernCheckBox}"
                                  IsChecked="{Binding Settings.MinimizeToTray}" Checked="OptionalSetting_Changed" Unchecked="OptionalSetting_Changed"/>
                        <TextBlock Text="إخفاء النافذة عند الضغط على إغلاق" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="29,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Server list -->
        <Border x:Name="ServerListSection" Grid.Row="4" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="قائمة السيرفرات" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="مرتبة حسب زمن UDP الفعلي؛ اختر سيرفرًا لتحديده في الصفحة الرئيسية" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Width="410" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox" Height="36" Style="{StaticResource DarkTextBox}"
                                 Padding="10,5,34,5" ToolTip="ابحث بالاسم أو البلد أو العنوان"
                                 TextChanged="Search_TextChanged"/>
                        <TextBlock Text="⌕" FontSize="20" Foreground="#78849A" Margin="11,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                        <TextBlock Text="بحث باسم السيرفر أو الدولة..." Foreground="#69758A" Margin="0,0,36,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Content="⟳ تحديث القائمة" Click="Refresh_Click" Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
                <ListView x:Name="ServerListView" Grid.Row="1" Background="#11151E"
                          BorderBrush="#282E3D" BorderThickness="1" Padding="5"
                          ItemsSource="{Binding FilteredServers}" SelectedItem="{Binding SelectedServer}"
                          FontFamily="Segoe UI Emoji" FontSize="12"
                          ItemContainerStyle="{StaticResource ServerRow}">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ServerHeader}"/>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="اسم السيرفر" Width="390" DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="البروتوكول" Width="150" DisplayMemberBinding="{Binding Protocol}"/>
                            <GridViewColumn Header="الدولة" Width="190" DisplayMemberBinding="{Binding Country}"/>
                            <GridViewColumn Header="Ping UDP" Width="110" DisplayMemberBinding="{Binding PingLabel}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Logs -->
        <Border x:Name="LogsSection" Grid.Row="5" Style="{StaticResource CardBorder}" Padding="14" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#61D895" Margin="0,0,8,0"/>
                        <TextBlock Text="سجل التشغيل" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="رسائل الاتصال والتشخيص" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBox x:Name="LogBox" Grid.Row="1" Background="#0E1117" Foreground="#8FE4A8"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11" IsReadOnly="True"
                         BorderBrush="#252B38" BorderThickness="1" Padding="10"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
