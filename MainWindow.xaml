<Window x:Class="FlareVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPNGS" Icon="{StaticResource VpnGsLogo}" Height="640" Width="420"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" Background="#12131C" Foreground="#E8ECF2"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Dark ComboBox style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2F3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="false" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#9AA4B2"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,32,0" VerticalAlignment="Center"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1E1E2E" BorderBrush="#2A2F3A" BorderThickness="1" CornerRadius="10"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True"
                                                  CanContentScroll="False"
                                                  PanningMode="None"
                                                  Focusable="False"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF6B35"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8DCE6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="38" Height="21" CornerRadius="11" Background="#34394A" Padding="3">
                                <Ellipse x:Name="Thumb" Width="15" Height="15" Fill="#AAB1C0" HorizontalAlignment="Left"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF6B35"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,0">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <Image Source="{StaticResource VpnGsLogo}" Width="32" Height="32" Margin="0,0,9,0"/>
                <TextBlock Text="VPNGS" FontSize="20" FontWeight="SemiBold" Foreground="#FF6B35"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Click="Advanced_Click" Width="36" Height="36"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" Foreground="#9AA4B2" BorderThickness="0"
                    FontSize="18" Cursor="Hand"/>
            <Button Content="☷" Click="Servers_Click" Width="36" Height="36" Margin="44,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="Transparent" Foreground="#9AA4B2" BorderThickness="0"
                    FontSize="20" Cursor="Hand" ToolTip="السيرفرات وسجل التشغيل"/>
        </Grid>

        <!-- Center -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
            <!-- Power button with glow -->
            <Grid HorizontalAlignment="Center">
                <Ellipse Width="200" Height="200" Fill="Transparent">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="GlowEffect" BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#FF6B35"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Button x:Name="PowerButton" Click="Connect_Click" Width="180" Height="180"
                        HorizontalAlignment="Center" Cursor="Hand" BorderThickness="0">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="PowerScale"/>
                    </Button.RenderTransform>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="ring" Fill="#1A1F29" Stroke="#2A2F3A" StrokeThickness="6"/>
                                <Ellipse x:Name="inner" Fill="#12161F" Margin="14"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Width="78" Height="78" HorizontalAlignment="Center">
                                        <Path x:Name="ConnectingSpinner"
                                              Data="M 50,8 A 42,42 0 1 1 8,50"
                                              Width="78" Height="78" Stretch="Fill"
                                              Stroke="#FFFFB547" StrokeThickness="7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="SpinnerRotation"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                                   Foreground="#FF6B35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="ButtonLabel" Text="{Binding ConnectButtonText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FF6B35" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter TargetName="ring" Property="Stroke" Value="#22C55E"/>
                                    <Setter TargetName="ring" Property="Fill" Value="#0F2A1F"/>
                                    <Setter TargetName="inner" Property="Fill" Value="#0B1F17"/>
                                    <Setter TargetName="PowerIcon" Property="Foreground" Value="#22C55E"/>
                                    <Setter TargetName="ButtonLabel" Property="Foreground" Value="#22C55E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                    <Setter TargetName="ring" Property="Stroke" Value="#FFB547"/>
                                    <Setter TargetName="ring" Property="Fill" Value="#30230F"/>
                                    <Setter TargetName="inner" Property="Fill" Value="#241B10"/>
                                    <Setter TargetName="ConnectingSpinner" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="PowerIcon" Property="Foreground" Value="#FFB547"/>
                                    <Setter TargetName="ButtonLabel" Property="Foreground" Value="#FFB547"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ConnectingSpin">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="ConnectingSpin"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="#E8ECF2"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>

            <!-- Country selector -->
            <Grid Margin="0,12,0,0" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="112"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#171A24" BorderBrush="#2A2F3A" BorderThickness="1"
                        CornerRadius="9" Margin="0,0,6,0">
                    <Grid>
                        <TextBlock Text="ابحث عن دولة أو سيرفر..." Foreground="#6F788A" FontSize="11"
                                   Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="#E8ECF2" BorderThickness="0"
                                 Padding="10,5" FontSize="12" VerticalContentAlignment="Center"
                                 FlowDirection="RightToLeft" ToolTip="ابحث بالدولة أو اسم السيرفر أو عنوانه"/>
                    </Grid>
                </Border>
                <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource ComboItem}"
                          SelectedValuePath="Tag" SelectedValue="{Binding PlatformFilter, Mode=TwoWay}"
                          Height="34" FontSize="11" ToolTip="فلتر حسب الاستخدام">
                    <ComboBoxItem Content="الكل" Tag="all"/>
                    <ComboBoxItem Content="ألعاب" Tag="games"/>
                    <ComboBoxItem Content="تصفح" Tag="browse"/>
                    <ComboBoxItem Content="مشاهدة" Tag="stream"/>
                </ComboBox>
            </Grid>
            <Border Background="#1E1E2E" CornerRadius="12" Padding="4,2" Margin="0,24,0,0">
                <ComboBox x:Name="ServerCombo" Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource ComboItem}"
                          ItemsSource="{Binding FilteredServers}"
                          SelectedItem="{Binding SelectedServer}"
                          IsSynchronizedWithCurrentItem="False"
                          IsEditable="False" IsTextSearchEnabled="False"
                          Height="40" FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid FlowDirection="LeftToRight" MinWidth="270">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="CountryFlag" Grid.Column="0" Source="{Binding CountryFlagUri}" Width="22" Height="16"
                                       Stretch="Fill" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ServerGlyph" Grid.Column="0" Text="&#xE753;" FontSize="15"
                                           VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Foreground="#FFB547"/>
                                <TextBlock Grid.Column="1" Text="{Binding UiDisplayName}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                <TextBlock Grid.Column="2" Text="{Binding PingLabel}" Margin="10,0,2,0"
                                           Foreground="#AEB7C8" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CountryFlagUri}" Value="{x:Null}">
                                    <Setter TargetName="ServerGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CountryFlag" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Id}" Value="auto">
                                    <Setter TargetName="ServerGlyph" Property="Text" Value="&#xE945;"/>
                                    <Setter TargetName="ServerGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CountryFlag" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>

            <!-- Info -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock FontSize="12" Foreground="#9AA4B2">
                    <Run Text="UDP: "/><Run x:Name="PingRun" Text="-" Foreground="#FFFFFF"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="#9AA4B2" Margin="16,0,0,0">
                    <Run Text="البروتوكول: "/><Run x:Name="ProtoRun" Text="-" Foreground="#FFFFFF"/>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#6B7280"
                       HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="300"/>

            <Border x:Name="HysteriaWarningPanel" Visibility="Collapsed" Margin="2,10,2,0"
                    Background="#2B2417" BorderBrush="#8A6330" BorderThickness="1"
                    CornerRadius="9" Padding="10,8">
                <TextBlock Text="تنبيه Hysteria2: قد يعطي سرعة جيدة، لكنه يعتمد على UDP/QUIC؛ فقد يتأثر بفقد الحزم أو حجب UDP أو قيود الشبكة والخادم، فتحدث انقطاعات. هذا يختلف حسب السيرفر والشبكة، وليس عيبًا ثابتًا في كل Hysteria2."
                           Foreground="#F3C982" FontSize="11" TextWrapping="Wrap"
                           TextAlignment="Right" FlowDirection="RightToLeft"/>
            </Border>
        </StackPanel>

        <!-- Full-window loading cover blocks clicks while subscriptions and server tests run. -->
        <Grid Grid.RowSpan="3" Background="#F012141C" Panel.ZIndex="100" Focusable="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoadingServers}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="#1B1E2A" BorderBrush="#3A4052" BorderThickness="1" CornerRadius="24"
                    Padding="26,28" HorizontalAlignment="Center" VerticalAlignment="Center" Width="366">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.48"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="104" Height="104" HorizontalAlignment="Center">
                        <Ellipse Fill="#151823" Stroke="#343A4A" StrokeThickness="5"/>
                        <Ellipse Margin="8" Fill="Transparent" Stroke="#FF6B35" StrokeThickness="3"
                                 StrokeDashArray="2,3"/>
                        <Image Source="{StaticResource VpnGsLogo}" Width="58" Height="58"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="جاري تجهيز السيرفرات" FontSize="20" FontWeight="Bold"
                               Foreground="#F4F6FB" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="VPNGS يقيس استجابة UDP الحقيقية عبر النفق"
                               FontSize="12" Foreground="#9AA4B2" HorizontalAlignment="Center"
                               Margin="0,6,0,14"/>
                    <Border Background="#151823" BorderBrush="#303648" BorderThickness="1"
                            CornerRadius="12" Padding="14,12" MinHeight="66" Width="310">
                        <TextBlock Text="{Binding LoadingMessage}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E8ECF2" TextAlignment="Center" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ProgressBar Width="290" Height="7" IsIndeterminate="True" Margin="0,18,0,0"
                                 Foreground="#FF6B35" Background="#34394A" BorderThickness="0"/>
                    <TextBlock Text="تظل عناصر البرنامج مقفلة حتى يكتمل الفحص"
                               FontSize="11" Foreground="#788296" HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0F131A" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <CheckBox x:Name="TunToggle" Content="TUN (كامل)" Style="{StaticResource ModernToggle}"
                          IsChecked="{Binding Settings.TunMode}" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"
                          Margin="0,0,20,0"/>
                <CheckBox x:Name="AutoRefreshToggle" Content="تحديث تلقائي" Style="{StaticResource ModernToggle}"
                          IsChecked="{Binding Settings.AutoRefresh}" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
